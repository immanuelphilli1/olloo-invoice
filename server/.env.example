# Copy to server/.env. In development every value is optional.

NODE_ENV=production
PORT=8787

# Public URL of the app (links in SMS/email, Paystack callback). Use https in production.
APP_URL=https://invoice.olloo.app

# Postgres. Leave empty in development to use the embedded PGlite database in .data/pglite.
DATABASE_URL=postgres://olloo:CHANGE_ME@localhost:5432/olloo_invoice

# Long random string (openssl rand -base64 48). Required in production; also signs OTP hashes.
SESSION_SECRET=

# Where logos and signatures are stored.
UPLOAD_DIR=/var/lib/olloo-invoice/uploads

# Serve the built web app from the API process (optional if Caddy serves web/dist).
# WEB_DIST=/opt/olloo-invoice/web/dist

# Paystack (dashboard → Settings → API Keys & Webhooks). Use sk_test_ keys until you go live.
PAYSTACK_SECRET_KEY=
# Create two Plans in Paystack (GHS 50 monthly, GHS 500 annually) and paste their codes.
PAYSTACK_PLAN_MONTHLY=PLN_
PAYSTACK_PLAN_YEARLY=PLN_
# Webhook URL to set in Paystack: https://invoice.olloo.app/api/billing/webhook

# SMS for phone login codes: console | arkesel | hubtel
SMS_PROVIDER=console
SMS_API_KEY=
# Hubtel only (client secret)
SMS_API_SECRET=
# Sender ID must be registered with the provider (max 11 chars)
SMS_SENDER_ID=olloo

# Email for password resets and renewal reminders: console | resend
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=olloo <no-reply@olloo.app>

# Emails / phone numbers (E.164, e.g. +233241234567) that get the Admin screen.
SUPERADMINS=you@example.com,+233200000000
