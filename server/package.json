{
  "name": "@olloo/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "reminders": "tsx --env-file-if-exists=.env src/jobs/runReminders.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@olloo/shared": "^0.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
